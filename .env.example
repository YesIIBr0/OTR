# --- OTR Aula · variables de entorno ---
# Copia este archivo a .env y rellena los valores.

# Base de datos.
# Desarrollo (SQLite):   file:./prisma/dev.db
# Producción (Hostinger, PostgreSQL): postgresql://USER:PASS@HOST:5432/DBNAME?schema=public
DATABASE_URL="file:./prisma/dev.db"

# Secreto para firmar la sesión (HMAC). OBLIGATORIO. Mínimo 16 caracteres.
# Genera uno fuerte:  openssl rand -hex 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Cron de recordatorios de sesión (F6.1). Secreto que autoriza POST /api/cron/reminders
# (el cron del VPS lo envía en el header x-cron-secret). FAIL-CLOSED: vacío → la ruta responde
# 503 y no se envía ningún recordatorio. Genera uno: openssl rand -hex 32
CRON_SECRET=""

# Stripe (opcional — solo si vendes cursos de pago).
# Sin estas claves, la inscripción a cursos con precio se hace directa (modo manual/gratis).
STRIPE_SECRET_KEY=""
# Secreto del endpoint de webhook (Dashboard de Stripe → Developers → Webhooks).
# Apunta el webhook a: https://TU-DOMINIO/api/stripe/webhook  (evento checkout.session.completed)
STRIPE_WEBHOOK_SECRET=""

# Cloudflare Stream (opcional — para video del LMS).
# Sin estas variables, el embed usa el iframe público genérico (funciona pegando el UID de un video público).
# Con el subdominio de cliente, se usa la URL específica de tu cuenta; el API token habilita
# (follow-up) la subida directa y los tokens firmados de reproducción para video protegido.
CLOUDFLARE_CUSTOMER_SUBDOMAIN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# WhatsApp Business — Meta Cloud API (opcional — bandeja del equipo en el panel admin).
# Sin estas variables, el webhook GET responde 403 y enviar mensajes falla suave (sin romper la app).
# Webhook a configurar en el dashboard de Meta: https://TU-DOMINIO/api/whatsapp/webhook
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Enlace del grupo de WhatsApp de la comunidad (paso 3 de la admisión).
# Si se deja vacío, el paso pinta su estado honesto ("seguimos montando el grupo")
# en vez de un enlace roto. Solo se acepta http(s) absoluto.
ADMISSION_COMMUNITY_URL=
